# Moonshot / Kimi API (Agent orchestration)
MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6
# Optional alias: KIMI_API_KEY

# Hugging Face Hub (optional — for gated models / higher rate limits)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Local Qwen model (RAG generation)
QWEN_MODEL_PATH=Qwen/Qwen3.5-0.8B
LORA_PATH=./models/qwen35_2b_lora
RAG_BACKEND=local
MAX_NEW_TOKENS=256

# RAG settings
RAG_TOP_K=3
CHUNK_SIZE=128
KNOWLEDGE_DIR=./data/knowledge
CHROMA_PERSIST_DIR=./data/chroma
RETRIEVER_TYPE=hybrid
EMBEDDING_MODEL=BAAI/bge-m3
HYBRID_RRF_K=60
AGENT_MAX_STEPS=2

# JWT auth (browser Web UI)
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=kefu_token
ADMIN_JWT_COOKIE_NAME=kefu_admin_token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
OAUTH_GOOGLE_CLIENT_ID=

# Database
DATABASE_URL=postgresql+asyncpg://kefu:kefu@localhost:5432/kefu
REDIS_URL=redis://localhost:6379/0

# Environment
ENV=development
# 开发环境聊天前台免 API Key（生产默认关闭，除非显式设为 true）
CHAT_PUBLIC_ACCESS=true

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production
# 管理后台请在「API Key」栏填写上面的值；切勿把真实密钥提交到仓库
# Set ENV=production in production; API_KEY is required and must not be default
QWEN_INFERENCE_URL=
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Session
SESSION_MAX_HISTORY=6
SESSION_REDIS_TTL=86400

# Logistics API (optional - uses mock if empty)
LOGISTICS_API_URL=
LOGISTICS_API_KEY=

# Order API (optional)
ORDER_API_URL=
ORDER_API_KEY=

# Complaint webhook (optional)
COMPLAINT_WEBHOOK_URL=

# API key rotation grace period (optional previous key)
API_KEY_PREVIOUS=

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=zhineng-kefu
OTEL_EXPORTER_OTLP_ENDPOINT=

# Logging
LOG_LEVEL=INFO
